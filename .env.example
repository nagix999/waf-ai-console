WAF_ADMIN_USERNAME=admin
WAF_ADMIN_PASSWORD=replace-with-a-long-password
WAF_SESSION_SECRET=replace-with-a-long-random-session-secret
WAF_SESSION_HTTPS_ONLY=false
WAF_DATA_ENCRYPTION_KEY=replace-with-a-fernet-key
WAF_ENCRYPTION_KEY_VERSION=prod-v1
WAF_AGENT_MODE=stub
WAF_WORKER_POLL_SECONDS=1
WAF_JOB_LEASE_SECONDS=300
# vLLM targets are managed in Settings > Internal Egress, not environment variables.
WAF_VLLM_TEST_LEASE_SECONDS=900
WAF_VERIFIER_CONFIDENCE_THRESHOLD=0.75

# Both images build the shared report component. Allow only build inputs.
**
!.dockerignore
!frontend/
frontend/*
!frontend/Dockerfile
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/vite.config.js
!frontend/nginx.conf
!frontend/src/
!frontend/src/**
!frontend/scripts/
frontend/scripts/*
!frontend/scripts/build-report.mjs
!docs/
docs/*
!docs/Production_API_v0.1.md
!backend/
backend/*
!backend/Dockerfile
!backend/pyproject.toml
!backend/alembic.ini
!backend/alembic/
!backend/alembic/**
!backend/app/
!backend/app/**
backend/app/data/report-ui/
backend/app/data/report-document.cjs

# Keep secrets and generated/dependency directories excluded even under src/.
**/.env*
**/*.env
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
**/keys
**/secrets
**/.git
**/node_modules
**/dist
**/dist-*
**/__pycache__
**/*.pyc
**/*.db
**/*.sqlite*
**/*.bak

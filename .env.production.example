# Copy to a private .env.production (mode 0600), then set the blank secrets.
# Never commit or print the real env file. This example intentionally cannot run.
WAF_ADMIN_USERNAME=admin
WAF_ADMIN_PASSWORD=
WAF_SESSION_SECRET=
WAF_DATA_ENCRYPTION_KEY=

# New installation: generate a unique Fernet key and back it up securely.
WAF_ENCRYPTION_KEY_VERSION=prod-v1

# TLS must terminate at the host reverse proxy before users access the console.
WAF_SESSION_HTTPS_ONLY=true
WAF_WEB_PORT=18080

# API, analysis worker and model-test worker receive the same execution mode.
# Model validation still makes actual LLM calls; stub is not a validation sandbox.
WAF_AGENT_MODE=moduagent
WAF_WORKER_POLL_SECONDS=1
WAF_JOB_LEASE_SECONDS=300
WAF_VLLM_TEST_LEASE_SECONDS=900
WAF_VERIFIER_CONFIDENCE_THRESHOLD=0.75

# Example build tags. Choose unique, immutable deployment tags for upgrades.
WAF_BACKEND_IMAGE=waf-ai-console-api:production-source
WAF_FRONTEND_IMAGE=waf-ai-console-frontend:production-source

# vLLM is deployed separately. Register its private IP/port in Internal Egress,
# then register and validate a profile before assigning Production and Test.
# Neither a vLLM allowlist nor service API keys are bootstrapped from this file.

# Copy to a private .env.production (mode 0600). Never commit or print it.
# Existing team Gateway, WAF-only automation: docs/Automated_Team_Deployment.md
# Required: team directory/project, administrator credentials, public HTTPS URL.
# This example cannot deploy unchanged. Do not source it in a shell.
WAF_TEAM_PROJECT_DIR=
WAF_TEAM_PROJECT_NAME=

WAF_ADMIN_USERNAME=admin
WAF_ADMIN_PASSWORD=
# Automation: blank values are generated once on FIRST deploy and retained in
# .local-deploy/automation/secrets.json (0600); the input env is never rewritten.
# Manual Compose: both values must be filled before running Compose directly.
WAF_SESSION_SECRET=
WAF_DATA_ENCRYPTION_KEY=

# New installation: generate a unique Fernet key and back it up securely.
WAF_ENCRYPTION_KEY_VERSION=prod-v1

# TLS terminates at the existing approved gateway (or a host reverse proxy).
WAF_PUBLIC_ORIGIN=https://waf.cyberailabs.team
WAF_SESSION_HTTPS_ONLY=true
WAF_WEB_PORT=18080

# These are Docker addresses, NOT company/VPN CIDRs. Check for overlap with
# existing Docker, host, VPN and vLLM routes. Automation checks before deployment.
# Blank automation defaults: 172.30.251.0/24 and 172.30.251.10.
# Manual Compose: these blank fields must be filled with a reviewed network plan.
WAF_PRIVATE_SUBNET=
WAF_PRIVATE_WEB_IP=
# Exact IPv4 peer seen by waf-web. Gateway-container mode: the gateway's static
# IP on its dedicated WAF edge network. Host-proxy mode: verify the host's actual
# Docker bridge peer IP; 127.0.0.1 from inside a container is not the host proxy.
# Blank automation default: 172.30.250.2, outside the dynamic edge IP pool.
WAF_TRUSTED_PROXY_IP=
# Dedicated network for gateway+waf-web, never WAF API/workers or the team's
# edge/control/Jupyter networks. Automation creates/checks this internal bridge.
WAF_EDGE_NETWORK=waf-console-edge
# Automation-only blank defaults: 172.30.250.0/24 and 172.30.250.128/25.
# If changing the subnet, change the pool and trusted gateway IP together.
WAF_EDGE_SUBNET=
WAF_EDGE_IP_RANGE=

# API, analysis worker and model-test worker receive the same execution mode.
# Model validation still makes actual LLM calls; stub is not a validation sandbox.
WAF_AGENT_MODE=moduagent
WAF_WORKER_POLL_SECONDS=1
WAF_JOB_LEASE_SECONDS=300
WAF_VLLM_TEST_LEASE_SECONDS=900
WAF_VERIFIER_CONFIDENCE_THRESHOLD=0.75

# Automation default build mode creates content-addressed WAF-owned tags.
# These tags select approved existing images only with --build-mode local;
# io.waf.deploy.owner/source labels must match this installation and source.
# Manual Compose also uses these tags; replace them with reviewed fixed tags.
WAF_BACKEND_IMAGE=waf-ai-console-api:production-source
WAF_FRONTEND_IMAGE=waf-ai-console-frontend:production-source

# vLLM is deployed separately. Register its private IP/port in Internal Egress,
# then register and validate a profile before assigning Production and Test.
# Neither a vLLM allowlist nor service API keys are bootstrapped from this file.
